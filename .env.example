OPENAI_API_KEY=sk-...

# shared secret for the n8n / whatsapp side (X-Service-Key header).
# generate with: openssl rand -hex 32
SERVICE_API_KEY=

# GCP creds come from ADC (gcloud auth application-default login) or GOOGLE_APPLICATION_CREDENTIALS
# PROJECT_ID=777556681966
# STORAGE_BUCKET=villas-del-lago-2-qr-code

# only needed if a browser client is added; the app and n8n are not browsers
# CORS_ORIGINS=https://admin.example.com

# serve stored documents via short-lived signed urls instead of the public
# ?alt=media form. requires roles/iam.serviceAccountTokenCreator on the runtime
# service account, and a coordinated app release.
# USE_SIGNED_URLS=true

# ENABLE_LISTENERS=true
# ENABLE_SCHEDULER=true
